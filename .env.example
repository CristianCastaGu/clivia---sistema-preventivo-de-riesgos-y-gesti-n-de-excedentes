# GEMINI_API_KEY: Required for Gemini AI API calls.
# Sin ella, el servidor usa el motor de respaldo offline (ver server.ts).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# --- Clima en tiempo real (/api/weather/live) ---
# Cada una es opcional: la fuente correspondiente simplemente se omite si falta.
# Open-Meteo no requiere key y siempre está activa.
OPENWEATHER_API_KEY=""
WEATHERAPI_KEY=""
METEOBLUE_API_KEY=""

# Punto de referencia del municipio (coordenadas IGAC) — usado como default
# cuando el cliente no envía lat/lon propias.
MUNICIPALITY_REF_LAT="4.9653"
MUNICIPALITY_REF_LON="-73.9144"
